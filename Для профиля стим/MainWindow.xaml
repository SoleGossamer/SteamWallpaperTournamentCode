<Window x:Class="WallpaperRanker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Wallpaper Tournament" Height="876" Width="1200" Background="#171a21">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="STEAM ARENA" FontSize="32" Foreground="#66c0f4" FontWeight="Bold" HorizontalAlignment="Center"/>
            <ProgressBar x:Name="ProgBar" Height="10" Width="400" Margin="10" Background="#1b2838" Foreground="#66c0f4"/>
            <TextBlock x:Name="TxtStats" Text="Пара: 0 / 0 | Очков распределено: 0" Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="BtnLeftContainer" Grid.Row="0" Click="BtnLeft_Click" Background="Black" BorderBrush="#66c0f4" BorderThickness="2">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Black" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" ClipToBounds="True">
                                <MediaElement x:Name="VideoLeftInside" 
                                  LoadedBehavior="Manual" UnloadedBehavior="Manual" 
                                  IsMuted="True" MediaEnded="Video_MediaEnded"
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Row="1" Content="УДАЛИТЬ ИЗ СПИСКА" Height="35" Margin="0,10,0,0" Click="BtnDeleteLeft_Click" Background="#4c1111" Foreground="White"/>
            </Grid>

            <Button Grid.Column="1" Content="SKIP" VerticalAlignment="Center" Margin="15,0"
            Width="70" Height="70" Background="#1b2838" Foreground="Gray" Click="BtnSkip_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="35"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Grid Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="BtnRightContainer" Grid.Row="0" Click="BtnRight_Click" Background="Black" BorderBrush="#66c0f4" BorderThickness="2">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Black" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" ClipToBounds="True">
                                <MediaElement x:Name="VideoRightInside" 
                                  LoadedBehavior="Manual" UnloadedBehavior="Manual" 
                                  IsMuted="True" MediaEnded="Video_MediaEnded"
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Row="1" Content="УДАЛИТЬ ИЗ СПИСКА" Height="35" Margin="0,10,0,0" Click="BtnDeleteRight_Click" Background="#4c1111" Foreground="White"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="ОБНУЛИТЬ ВСЁ" Click="Reset_Click" Margin="10,0" Width="120" Background="#4c1111" Foreground="White"/>
            <Button Content="ОТКРЫТЬ ТЕКУЩИЙ ТОП" Click="ShowTop_Click" Width="200" Background="#2a475e" Foreground="White"/>
            <Button Content="ИЗМЕНИТЬ СПИСОК" Click="OpenWallpapers_Click" Width="180" Background="#2a475e" Foreground="White" Margin="10,0"/>
        </StackPanel>
    </Grid>
</Window>